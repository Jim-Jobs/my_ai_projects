page {
  background: #f4f4f7;
  color: #1c1c24;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.page { padding: 40rpx 32rpx 80rpx; }

.hero { text-align: center; padding: 40rpx 0 24rpx; }
.hero .title { font-size: 52rpx; font-weight: 700; display: block; }
.hero .sub { font-size: 26rpx; color: #888; margin-top: 10rpx; display: block; }

.btn {
  width: 100%; margin: 22rpx 0; padding: 28rpx; border-radius: 16rpx;
  font-size: 32rpx; font-weight: 700; text-align: center; box-sizing: border-box;
  line-height: 1.4;
}
.btn::after { border: none; }
.btn.primary { background: #1c1c24; color: #fff; }
.btn.ghost { background: #fff; color: #1c1c24; border: 2rpx solid #1c1c24; }
.btn.plain { background: #fff; color: #888; border: 2rpx dashed #ccc; font-weight: 400; }

.label { font-size: 26rpx; color: #888; margin: 36rpx 0 14rpx; font-weight: 600; }
.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag {
  font-size: 26rpx; padding: 12rpx 26rpx; border-radius: 40rpx;
  background: #fff; border: 2rpx solid #dcdce3; color: #1c1c24;
}
.tag.on { background: #1c1c24; color: #fff; border-color: #1c1c24; }

textarea, input {
  width: 100%; box-sizing: border-box; padding: 20rpx; border-radius: 16rpx;
  background: #fff; border: 2rpx solid #dcdce3; font-size: 28rpx;
}
textarea { min-height: 160rpx; }

.hint { font-size: 24rpx; color: #d97070; margin-top: 12rpx; display: none; }
.hint.show { display: block; }

.sample {
  background: #fff; border: 1rpx solid #e6e6ec; border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.sample .s-t { font-weight: 600; font-size: 28rpx; display: block; }
.sample .s-e { color: #888; font-size: 24rpx; margin-top: 4rpx; display: block; }

.tomb {
  background: linear-gradient(180deg, #23232c, #101014);
  color: #e8e4d8; border-radius: 20rpx 20rpx 12rpx 12rpx;
  padding: 36rpx 32rpx;
}
.tomb .cross { text-align: center; font-size: 44rpx; color: #d9a95c; }
.tomb .rname { text-align: center; font-size: 38rpx; font-weight: 700; color: #fff; margin: 10rpx 0 18rpx; }
.tomb .epitaph {
  text-align: center; font-size: 28rpx; font-style: italic;
  border-top: 1rpx solid #3a3a44; border-bottom: 1rpx solid #3a3a44;
  padding: 22rpx 8rpx; margin-bottom: 26rpx;
}
.tomb .blk { margin-bottom: 22rpx; }
.tomb .blk .h { font-size: 22rpx; color: #d9a95c; font-weight: 700; margin-bottom: 12rpx; }
.tomb .blk .item { font-size: 26rpx; padding: 6rpx 0 6rpx 20rpx; position: relative; }
.tomb .blk .item::before { content: "·"; position: absolute; left: 0; color: #d9a95c; }

.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.actions .btn { flex: 1; margin: 0; }
.note { font-size: 22rpx; color: #999; text-align: center; margin-top: 16rpx; }

.hidden-canvas { position: fixed; left: -9999px; top: 0; }
